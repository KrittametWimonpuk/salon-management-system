{
  "family": "${APP_NAME}-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "${TASK_CPU}",
  "memory": "${TASK_MEMORY}",
  "executionRoleArn": "${EXEC_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "${IMAGE_API}",
      "essential": true,
      "portMappings": [{ "containerPort": 4000 }],
      "environment": [
        { "name": "JWT_ISSUER", "value": "${JWT_ISSUER}" },
        { "name": "JWT_AUDIENCE", "value": "${JWT_AUDIENCE}" },
        { "name": "CORS_ORIGINS", "value": "${CORS_ORIGINS}" },
        { "name": "COOKIE_SECURE", "value": "true" },
        { "name": "COOKIE_SAME_SITE", "value": "strict" },
        { "name": "TRUST_PROXY", "value": "1" },
        { "name": "PORT", "value": "4000" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "${DATABASE_URL_SECRET_ARN}" },
        { "name": "JWT_ACCESS_SECRET", "valueFrom": "${JWT_ACCESS_SECRET_ARN}" },
        { "name": "JWT_REFRESH_SECRET", "valueFrom": "${JWT_REFRESH_SECRET_ARN}" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/${APP_NAME}-api",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
