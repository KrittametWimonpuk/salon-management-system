# ---------------------------------------------------------------------------
# ตัวอย่างค่า Environment Variable
# วิธีใช้:  คัดลอกไฟล์นี้เป็น .env  แล้วแก้ค่าตามต้องการ
#   cp .env.example .env
# ---------------------------------------------------------------------------

# สาย connect ไปยัง PostgreSQL
# รูปแบบ: postgresql://<user>:<password>@<host>:<port>/<database>
# ค่านี้ตรงกับ docker-compose.yml (service ชื่อ db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appdb?schema=public"

# ใช้ secret คนละชุดสำหรับ access/refresh token และเก็บค่าจริงใน Secrets Manager
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-secret"
JWT_ISSUER="salon-api"
JWT_AUDIENCE="salon-web"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Origins ที่ browser อนุญาตให้ส่ง credential คั่นด้วย comma
CORS_ORIGINS="http://localhost:8080"
COOKIE_SECURE=false
COOKIE_SAME_SITE="strict"
TRUST_PROXY=1
REQUEST_BODY_LIMIT="100kb"
RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# JSON object; omitted flags default to false.
FEATURE_FLAGS="{}"

# พอร์ตที่ API จะรัน
PORT=4000
